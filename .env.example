# Copy to .env.local for development. Never commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hurghada_journeys?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Generate a strong random value for production (32+ bytes).
AUTH_SECRET="replace-with-at-least-43-random-characters-before-production"

# Used only by scripts\\windows\\create-admin.cmd / npm run admin:create.
# Do not commit real credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-development-password"

# International format, digits only. Example for Egypt: 201001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Optional Google Search Console verification token. Leave blank until configured.
GOOGLE_SITE_VERIFICATION=""

# Trust x-forwarded-for/x-real-ip only when your hosting provider sanitizes these headers.
TRUST_PROXY_HEADERS="false"
