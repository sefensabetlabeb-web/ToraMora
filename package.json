{
  "name": "hurghada-journeys",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "i18n:audit": "node scripts/audit-translations.mjs",
    "postinstall": "prisma generate",
    "performance:audit": "node scripts/performance-audit.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:e2e",
    "production:guard": "node scripts/production/readiness-check.mjs",
    "production:check": "npm run production:guard && npm run lint && npm run typecheck && npm run test:unit",
    "production:build": "npm run production:guard && npm run db:generate && next build",
    "production:start": "next start",
    "security:audit": "node scripts/security-audit.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "final:audit": "node scripts/final/static-audit.mjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.11",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.16.3",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.7.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "@types/pg": "8.15.5",
    "dotenv": "17.2.3",
    "tsx": "4.20.6",
    "@types/bcryptjs": "2.4.6",
    "vitest": "3.2.4",
    "@playwright/test": "1.55.0"
  }
}
