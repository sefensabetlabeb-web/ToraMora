generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Trip {
  id               String   @id @default(cuid())
  slug             String   @unique
  status           String   @default("draft")
  category         String
  categoryLabel    String
  title            String
  eyebrow          String?
  shortDescription String
  duration         String
  priceFrom        Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD")
  priceMode        String   @default("live")
  featured         Boolean  @default(false)
  popular          Boolean  @default(false)
  sortOrder        Int      @default(100)
  heroImage        String?
  gallery          Json?
  highlights       Json?
  itinerary        Json?
  included         Json?
  excluded         Json?
  whatToBring      Json?
  whatsappMessage  String?
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  translations     TripTranslation[]

  @@index([status, sortOrder])
  @@index([category, status])
}

model TripTranslation {
  id               String   @id @default(cuid())
  tripId           String
  locale           String
  title            String
  eyebrow          String?
  shortDescription String
  duration         String?
  gallery          Json?
  highlights       Json?
  itinerary        Json?
  included         Json?
  excluded         Json?
  whatToBring      Json?
  whatsappMessage  String?
  seoTitle         String?
  seoDescription   String?
  isReviewed       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, locale])
  @@index([locale])
  @@index([tripId, locale])
}

model ContactMessage {
  id         String   @id @default(cuid())
  status     String   @default("new")
  name       String
  email      String?
  phone      String?
  country    String?
  hotelName  String?
  roomNumber String?
  tripSlug   String?
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([tripSlug])
}

model BookingRequest {
  id             String   @id @default(cuid())
  status         String   @default("new")
  tripSlug       String
  preferredDate DateTime
  adults         Int
  children       Int      @default(0)
  hotelName      String
  roomNumber     String?
  name           String
  phone          String
  email          String?
  country        String?
  specialRequest String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([tripSlug, preferredDate])
}

model SiteSetting {
  id              String   @id @default("global")
  websiteName     String   @default("Hurghada Journeys")
  tagline         String   @default("Egypt starts here.")
  logoPath        String   @default("/brand/logo-mark.svg")
  whatsappNumber  String?
  email           String?
  phone           String?
  currency        String   @default("USD")
  defaultLanguage String   @default("en")
  facebook        String?
  instagram       String?
  updatedAt       DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  sessionVersion Int    @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Review {
  id        String   @id @default(cuid())
  status    String   @default("draft")
  name      String
  country   String?
  rating    Int
  title     String?
  text      String
  tripSlug  String?
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([tripSlug])
}

model MediaAsset {
  id        String   @id @default(cuid())
  label     String
  path      String   @unique
  altText   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
}
