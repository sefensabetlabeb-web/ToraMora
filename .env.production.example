# Hurghada Journeys — production environment template
# Copy these values into the hosting provider's secret/environment settings.
# NEVER commit a real .env.production file.

NODE_ENV="production"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hurghada_journeys?sslmode=require"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Generate with: scripts\windows\generate-auth-secret.ps1
AUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET"

# International format, digits only (example format only; use the real business number).
NEXT_PUBLIC_WHATSAPP_NUMBER="201000000000"

# Optional Search Console verification token.
GOOGLE_SITE_VERIFICATION=""

# Seed/admin scripts only. Prefer creating the first admin during a controlled deployment step.
ADMIN_EMAIL="admin@your-domain.example"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_ADMIN_PASSWORD"

# Trust x-forwarded-for/x-real-ip only when your hosting provider sanitizes these headers.
TRUST_PROXY_HEADERS="false"
